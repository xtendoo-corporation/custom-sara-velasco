<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Herencia de la vista web.external_layout_bubble -->
    <template id="external_layout_bubble_inherit" inherit_id="web.external_layout_bubble">
        <!-- Reemplazar la fila del header para mover el logo a la izquierda -->
        <xpath expr="//table[hasclass('o_ignore_layout_styling')][1]//tr" position="replace">
            <tr>
                <!-- Logo a la izquierda -->
                <td class="p-0 text-start">
                    <img t-if="company.logo" class="o_company_logo mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    <div name="company_address">
                        <ul class="list-unstyled" name="company_address_list">
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                            </li>
                            <li t-else="">
                                <span t-field="company.company_details"/>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-esc="forced_vat"/>
                            </li>
                        </ul>
                    </div>
                </td>
                <!-- Tagline a la derecha -->
                <td t-if="company.report_header" class="o_company_tagline fw-bold p-0 ps-2 text-end align-top">
                    <span t-field="company.report_header"/>
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
